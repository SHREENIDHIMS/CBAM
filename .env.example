# CBAM — environment variables.
# Copy to .env for local development and fill in values. NEVER commit .env.
# Local Supabase values are printed by `supabase start` / `supabase status`.
# Regulatory values (thresholds, rates, deadlines...) are NOT configuration:
# they are reference data (backend/refdata/), see docs/TECHNICAL_SPEC.md §6.

# --- App ---
APP_ENV=local                         # local | ci | staging | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173/portal
BRAND_NAME=CBAM                       # placeholder until BRAND-DEC-015

# --- Database (Supabase Postgres, schema cbam) ---
# App role cbam_app: no BYPASSRLS, not owner. Never the postgres user in the app.
DATABASE_URL=postgresql+psycopg://cbam_app:change-me@127.0.0.1:54322/postgres
# Owner role, used only by Alembic migrations.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://cbam_owner:change-me@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql+psycopg://cbam_owner:change-me@127.0.0.1:54322/cbam_test

# --- Supabase (Auth + Storage) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                    # public; frontend uses it for Auth only
SUPABASE_SERVICE_ROLE_KEY=            # SECRET; backend only (Storage, inviting users); never in frontend, logs or errors
SUPABASE_JWT_AUDIENCE=authenticated
# Local development only: older Supabase CLI versions sign tokens with a shared secret instead
# of the JWKS keys. The app refuses to start in production if this is set. Leave empty if
# `supabase status` shows asymmetric (ES256) signing keys.
SUPABASE_JWT_SECRET=
# How recent a login must be for sensitive actions (decided 3 Oct 2026).
RECENT_AUTH_MINUTES=15
# Product workflow, not law: days overdue at which a task escalates (JSON list).
TASK_ESCALATION_OVERDUE_DAYS=[7,14,28]
SUPABASE_STORAGE_BUCKET_EVIDENCE=cbam-evidence
SUPABASE_STORAGE_BUCKET_EXPORTS=cbam-exports
SUPABASE_STORAGE_BUCKET_IMPORTS=customs-imports   # private bucket for original CDS files (R1-003)

# --- Frontend (Vite exposes only VITE_*) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# --- Jobs (Celery + Redis) ---
# 127.0.0.1, not localhost: on Windows localhost can resolve to IPv6 and Docker resets it.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (Resend) ---
EMAIL_BACKEND=local                   # local (Supabase mail catcher via SMTP) | resend
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
RESEND_API_KEY=                       # SECRET
RESEND_WEBHOOK_SECRET=                # SECRET
EMAIL_FROM=no-reply@cbam.example      # real domain after BRAND-DEC-015

# --- Supplier portal (R1-017, R1-041) ---
MAGIC_LINK_TTL_HOURS=168
PORTAL_SESSION_IDLE_MINUTES=30

# --- Outreach test time-scale (R1-053) ---
# Seconds that count as one "day" in the Day 0/7/14/21/28 schedule.
# Production MUST be 86400 (the app refuses to start otherwise). Staging may use e.g. 60.
OUTREACH_TIME_SCALE_SECONDS_PER_DAY=86400

# --- Uploads (R1-048) ---
# Largest customs file (bytes) the import endpoint accepts; 413 above it. Operational, not law.
IMPORT_MAX_FILE_BYTES=52428800
# Uploads one client may have in flight at once per API process; 429 with Retry-After above it.
IMPORT_MAX_CONCURRENT_UPLOADS_PER_TENANT=3
# Limits for reading one customs file; a file over a limit is rejected with a file-level code.
IMPORT_MAX_COLUMNS=200
IMPORT_MAX_HEADING_CHARS=200
IMPORT_MAX_CELL_CHARS=4096
IMPORT_MAX_ROW_CHARS=1048576
# Rows are saved in chunks of 500 rows or this many characters, whichever comes first.
IMPORT_CHUNK_MAX_BYTES=8388608
# A batch started more than this many times is marked failed (worker crash loop).
IMPORT_MAX_ATTEMPTS=8
# A running import job renews its lease (seconds) after every chunk; an expired lease means the
# worker died and the sweeper takes the batch over.
IMPORT_LEASE_SECONDS=300
# Batches still received/queued after this many minutes are re-queued by the beat sweeper.
IMPORT_STALE_BATCH_MINUTES=10
# Celery recycles a worker process above this memory (KiB); 0 = off.
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=524288
UPLOAD_MAX_MB=25
MALWARE_SCAN_URL=                     # empty = scan hook disabled locally (files stay 'pending' in staging/prod)

# --- Security ---
SIGNED_URL_TTL_SECONDS=300            # 1 to 300; signed URLs never live longer than 5 minutes
SUPPORT_ACCESS_DEFAULT_MINUTES=60

# --- Release switches (not legal switches) ---
FEATURE_R2_ENABLED=false
FEATURE_R3_ENABLED=false

# --- Third-party processing (R2-030); off unless a tenant enables it ---
ANTHROPIC_API_KEY=                    # SECRET; used only by R2 extraction under R2-030

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
