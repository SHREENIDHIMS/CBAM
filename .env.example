# CBAM — environment variables.
# Copy to .env for local development and fill in values. NEVER commit .env.
# Local Supabase values are printed by `supabase start` / `supabase status`.
# Regulatory values (thresholds, rates, deadlines...) are NOT configuration:
# they are reference data (backend/refdata/), see docs/TECHNICAL_SPEC.md §6.

# --- App ---
APP_ENV=local                         # local | ci | staging | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173/portal
BRAND_NAME=CBAM                       # placeholder until BRAND-DEC-015

# --- Database (Supabase Postgres, schema cbam) ---
# App role cbam_app: no BYPASSRLS, not owner. Never the postgres user in the app.
DATABASE_URL=postgresql+psycopg://cbam_app:change-me@127.0.0.1:54322/postgres
# Owner role, used only by Alembic migrations.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://cbam_owner:change-me@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql+psycopg://cbam_owner:change-me@127.0.0.1:54322/cbam_test

# --- Supabase (Auth + Storage) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                    # public; frontend uses it for Auth only
SUPABASE_SERVICE_ROLE_KEY=            # SECRET; backend Storage only; never in frontend or logs
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET_EVIDENCE=cbam-evidence
SUPABASE_STORAGE_BUCKET_EXPORTS=cbam-exports

# --- Frontend (Vite exposes only VITE_*) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# --- Jobs (Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Email (Resend) ---
EMAIL_BACKEND=local                   # local (Supabase mail catcher via SMTP) | resend
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
RESEND_API_KEY=                       # SECRET
RESEND_WEBHOOK_SECRET=                # SECRET
EMAIL_FROM=no-reply@cbam.example      # real domain after BRAND-DEC-015

# --- Supplier portal (R1-017, R1-041) ---
MAGIC_LINK_TTL_HOURS=168
PORTAL_SESSION_IDLE_MINUTES=30

# --- Outreach test time-scale (R1-053) ---
# Seconds that count as one "day" in the Day 0/7/14/21/28 schedule.
# Production MUST be 86400 (the app refuses to start otherwise). Staging may use e.g. 60.
OUTREACH_TIME_SCALE_SECONDS_PER_DAY=86400

# --- Uploads (R1-048) ---
UPLOAD_MAX_MB=25
MALWARE_SCAN_URL=                     # empty = scan hook disabled locally (files stay 'pending' in staging/prod)

# --- Security ---
SIGNED_URL_TTL_SECONDS=300
SUPPORT_ACCESS_DEFAULT_MINUTES=60

# --- Release switches (not legal switches) ---
FEATURE_R2_ENABLED=false
FEATURE_R3_ENABLED=false

# --- Third-party processing (R2-030); off unless a tenant enables it ---
ANTHROPIC_API_KEY=                    # SECRET; used only by R2 extraction under R2-030

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
